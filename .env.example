# Application Configuration
PORT=3000
NODE_ENV=development
API_PREFIX=v1

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL="postgresql://vankaal_user:vankaal_password@localhost:5432/vankaal_healthcare?schema=public"

# Security & API Key
API_KEY_SALT="vankaal_healthcare_secret_salt_2026"
CORS_ORIGIN="*"

# Redis Configuration (BullMQ Background Scheduling)
REDIS_HOST="localhost"
REDIS_PORT=6379

# Reminder Engine Defaults (Minutes before appointment)
DEFAULT_SMS_LEAD_MINUTES=60
DEFAULT_VOICE_LEAD_MINUTES=30
MINIMUM_VOICE_LEAD_MINUTES=5

# Documentation
ENABLE_SWAGGER=true
